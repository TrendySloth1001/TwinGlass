<?xml version="1.0" encoding="utf-8"?>
<!-- Twinglass launcher icon (same design as the Mac app: build/icon.svg): twin glass panes of the
     same size on a violet gradient; the one behind is clear glass, the one in front frosted, and the
     back pane's edge shows faintly through the front one. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF8B6CFF" />
                <item android:offset="1" android:color="#FF4A27D4" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Back pane: clear glass. -->
    <path android:strokeColor="#A0FFFFFF" android:strokeWidth="1.4" android:fillColor="#24FFFFFF"
        android:pathData="M36.5,33h15a7.5,7.5 0 0 1 7.5,7.5v32a7.5,7.5 0 0 1 -7.5,7.5h-15a7.5,7.5 0 0 1 -7.5,-7.5v-32a7.5,7.5 0 0 1 7.5,-7.5z" />
    <!-- Front pane: frosted. -->
    <path android:fillColor="#F5FFFFFF"
        android:pathData="M56.5,28h15a7.5,7.5 0 0 1 7.5,7.5v32a7.5,7.5 0 0 1 -7.5,7.5h-15a7.5,7.5 0 0 1 -7.5,-7.5v-32a7.5,7.5 0 0 1 7.5,-7.5z" />
    <!-- The back pane's edge, seen through the front one. -->
    <group>
        <clip-path android:pathData="M56.5,28h15a7.5,7.5 0 0 1 7.5,7.5v32a7.5,7.5 0 0 1 -7.5,7.5h-15a7.5,7.5 0 0 1 -7.5,-7.5v-32a7.5,7.5 0 0 1 7.5,-7.5z" />
        <path android:strokeColor="#597C5CFF" android:strokeWidth="1.2" android:fillColor="#1F7C5CFF"
            android:pathData="M36.5,33h15a7.5,7.5 0 0 1 7.5,7.5v32a7.5,7.5 0 0 1 -7.5,7.5h-15a7.5,7.5 0 0 1 -7.5,-7.5v-32a7.5,7.5 0 0 1 7.5,-7.5z" />
    </group>
</vector>
