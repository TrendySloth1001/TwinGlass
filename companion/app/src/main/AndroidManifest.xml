<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talks to Twinglass on the Mac through `adb reverse` (localhost). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Connection type (Wi-Fi / mobile) for the phone details; a normal, install-time permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Wi-Fi, no setup" mirroring (no developer mode): find the Mac (mDNS), share the screen
         from a foreground service, show its ongoing notification. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility: lets IconReceiver see launcher apps to read their icons. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Twinglass"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mirror to Mac without developer mode (screen capture → encoder → the Mac). -->
        <service
            android:name=".direct.MirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Share to Mac: text / links onto the Mac clipboard, files into ~/Downloads/Twinglass. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Send to Mac"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Twinglass.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Twinglass (Mac) hands over its link key here, through an adb "am broadcast" with
             string extras key and mac, and an int extra port (see src/main/companion-link.ts).
             android.permission.DUMP: the adb shell has it, ordinary apps can't, so no other app can
             plant a key. -->
        <receiver
            android:name=".LinkReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Twinglass asks for app icons (for its app grid) through adb only, same DUMP guard. -->
        <receiver
            android:name=".IconReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Agent requests (UI tree / press an element on any display), same adb-only guard. -->
        <receiver
            android:name=".AgentReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Off until the user switches on "Agents read any screen" in Twinglass (Settings → Agents). -->
        <service
            android:name=".AgentService"
            android:exported="false"
            android:label="@string/agent_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_service" />
        </service>

        <!-- …and for this phone's details (Settings-style info shown on the Mac), same guard. -->
        <receiver
            android:name=".InfoReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

    </application>
</manifest>
