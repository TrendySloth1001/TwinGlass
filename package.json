{
  "name": "mob-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "Mirror and control Android phones from the desktop over USB or Wi-Fi",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev --watch",
    "dev:debug": "env -u ELECTRON_RUN_AS_NODE electron-vite dev --watch --remoteDebuggingPort 9333",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-server": "node scripts/fetch-server.mjs",
    "postinstall": "node scripts/fetch-server.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64",
    "ui:add": "node scripts/ui-add.mjs",
    "companion:build": "cd companion && ./gradlew assembleRelease -q",
    "companion:install": "npm run companion:build && adb install -r companion/app/build/outputs/apk/release/app-release.apk"
  },
  "devDependencies": {
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "author": "Mob Mirror"
}
